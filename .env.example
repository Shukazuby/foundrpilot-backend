# Server
PORT=4000
NODE_ENV=development

# MongoDB (e.g. mongodb://localhost:27017/foundrpilot)
MONGODB_URI=mongodb://localhost:27017/foundrpilot

# Redis for rate limiting (e.g. redis://localhost:6379)
REDIS_HOST=localhost
REDIS_PORT=6379

# Google Gemini API - get key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# JWT secret for auth (use a long random string in production)
JWT_SECRET=your_jwt_secret_change_in_production
